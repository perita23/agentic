{
  "name": "agentic-console",
  "version": "0.65.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/agentic.mjs dev",
    "build": "next build",
    "start": "node scripts/agentic.mjs start",
    "url": "node scripts/agentic.mjs url",
    "rotate-token": "node scripts/agentic.mjs url --rotate-token",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "reset-auth": "node scripts/agentic.mjs url --reset-auth",
    "desktop:prepare": "AGENTIC_STANDALONE=1 next build && node desktop/scripts/prepare.cjs",
    "desktop:dev": "npm run desktop:prepare && npm --prefix desktop start",
    "desktop:dist": "npm run desktop:prepare && npm --prefix desktop run dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.0",
    "imapflow": "^2.10.0",
    "lucide-react": "^1.67.0",
    "mailparser": "^3.14.1",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "nspell": "^2.1.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "Consola web local para gestionar sesiones, agentes, tareas y proyectos de Claude Code",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20.9"
  }
}
